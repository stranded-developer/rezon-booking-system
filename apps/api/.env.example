# Copy to .env.local for local development. Values for local Supabase come from `pnpm exec supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters, e.g. `openssl rand -hex 32`
OPERATOR_TOKEN_SECRET=
OPERATOR_IDLE_SECONDS=300
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=5
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=8787
