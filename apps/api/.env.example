# Copy to .env.local for local development. Values for local Supabase come from `pnpm exec supabase status`.
# On Vercel these are set per environment in Project Settings → Environment Variables (see spec/deploy.md).

# ── Database (server only; the service-role key bypasses every rule) ─────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Secrets (at least 32 random characters, e.g. `openssl rand -hex 32`) ─────
# Signs POS operator tokens.
OPERATOR_TOKEN_SECRET=
# Member QR codes are derived from this. Changing it invalidates every member card.
QR_TOKEN_SECRET=
# Bearer token for the scheduled jobs. On Vercel, set CRON_SECRET and Vercel Cron sends it itself.
CRON_SECRET=

# ── POS operator rules ──────────────────────────────────────────────────────
OPERATOR_IDLE_SECONDS=300
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=5

# ── Stripe (test keys locally; live keys only in production) ────────────────
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the endpoint's signing secret on Stripe.
STRIPE_WEBHOOK_SECRET=

# ── Where customers end up ──────────────────────────────────────────────────
# The booking website: used for booking links in emails and for Stripe return URLs.
BOOKING_SITE_URL=http://localhost:3000
# Pages a membership Checkout returns to (the counter QR flow shows these on the till screen).
CHECKOUT_SUCCESS_URL=http://localhost:8787/checkout/complete
CHECKOUT_CANCEL_URL=http://localhost:8787/checkout/cancelled

# ── Email ───────────────────────────────────────────────────────────────────
# "console" logs emails to the server output and email_log. Resend arrives in Phase 7.
EMAIL_TRANSPORT=console
EMAIL_FROM=Raceground <hello@raceground.local>

# ── Browsers allowed to call the API (comma separated) ──────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Local server only (Vercel sets its own port) ────────────────────────────
PORT=8787
