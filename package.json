{
  "name": "raceground",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:start": "supabase start -x imgproxy,logflare,vector,supavisor,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "supabase": "2.117.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
